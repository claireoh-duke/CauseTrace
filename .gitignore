# ---------------------------------------------------------------------------
# CauseTrace .gitignore
# ---------------------------------------------------------------------------

# --- Operating system / editors -------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
.idea/

# --- Secrets and local configuration --------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
secrets*.json
.netrc

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Node / frontend ------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local run state and logs ---------------------------------------------
.run/
*.log
*.pid
*.tmp
tmp/

# --- Runtime data and search indexes (large; see data/README.md) ----------
# The research dataset and derived indexes are NOT part of this repository.
data/*
!data/README.md
indexes/*
!indexes/README.md
*.faiss
*.parquet
*.feather
*.arrow

# --- Model artifacts and caches -------------------------------------------
# BGE-M3 and Qwen weights live in the Hugging Face / Ollama caches, never here.
*.safetensors
*.gguf
*.ggml
*.bin
*.pt
*.pth
*.ckpt
*.onnx
.cache/
huggingface/
.ollama/

# --- Generated evaluation output -------------------------------------------
# Output of `python -m causetrace.evaluate --output ...`
eval_results*.json
evaluation/raw/
evaluation/**/retrieved_evidence.json
evaluation/**/*_request.json
evaluation/**/*_response.json
evaluation/**/run_metadata.json

# --- Archives and exports ---------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
